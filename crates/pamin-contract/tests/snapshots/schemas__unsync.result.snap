---
source: crates/pamin-contract/tests/schemas.rs
expression: "schema_for! (unsync::Unsynced)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unsynced",
  "type": "object",
  "properties": {
    "removed": {
      "description": "The paths no longer kept in sync. Their sections stay as they are.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown": {
      "description": "The paths that were not kept in sync to begin with.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "removed",
    "unknown"
  ]
}
