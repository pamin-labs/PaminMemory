---
source: crates/pamin-contract/tests/schemas.rs
expression: "schema_for! (neighbors::Neighborhood)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neighborhood",
  "type": "object",
  "properties": {
    "depth": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "neighbors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Neighbor"
      }
    },
    "topic": {
      "type": "string"
    }
  },
  "required": [
    "topic",
    "depth",
    "neighbors"
  ],
  "$defs": {
    "Neighbor": {
      "type": "object",
      "properties": {
        "asserted_from": {
          "description": "The end the final edge was asserted from, and the end it points at.\n\nThe walk is undirected, so `via` says how this topic was reached and\nnot what was claimed. For `depends_on`, `supersedes`, `contradicts`,\n`derived_from` and `part_of` the direction is the claim, and reading it\noff `via` gives the opposite answer depending on which end the walk\nstarted from. These two say it outright.",
          "type": "string"
        },
        "asserted_to": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "format": "float"
        },
        "derivation": {
          "description": "Whether the edge was asserted by a caller or derived by the engine.",
          "type": "string"
        },
        "edge": {
          "type": "string"
        },
        "hops": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "topic": {
          "type": "string"
        },
        "via": {
          "description": "The topic on the other end of the final edge.",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "hops",
        "via",
        "edge",
        "asserted_from",
        "asserted_to",
        "derivation",
        "confidence"
      ]
    }
  }
}
