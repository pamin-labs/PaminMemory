---
source: crates/pamin-contract/tests/schemas.rs
expression: "schema_for! (topics::Topics)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topics",
  "type": "object",
  "properties": {
    "query": {
      "description": "Absent when nothing was asked for, so the list is simply what is here.",
      "type": [
        "string",
        "null"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Found"
      }
    },
    "total": {
      "description": "How many topics the project holds, which is the context the page needs:\ntwenty of twenty-two is the whole story, twenty of nine thousand is a\nsample and the caller should narrow instead.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "total",
    "topics"
  ],
  "$defs": {
    "Found": {
      "type": "object",
      "properties": {
        "how": {
          "description": "`name` when the name index matched, `content` when a memory under it\ndid, `both` when each did. Which one it was is the difference between\n\"this topic is about that\" and \"this topic is called that\".",
          "type": "string"
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "topic",
        "how"
      ]
    }
  }
}
