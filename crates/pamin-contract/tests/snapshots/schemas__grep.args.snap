---
source: crates/pamin-contract/tests/schemas.rs
expression: "schema_for! (grep::Args)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Args",
  "type": "object",
  "properties": {
    "ignore_case": {
      "description": "Ignore case.",
      "type": "boolean",
      "default": false
    },
    "limit": {
      "description": "How many matches to return.",
      "type": "integer",
      "format": "uint32",
      "default": 20,
      "minimum": 0
    },
    "literal": {
      "description": "The exact string to find. Not a pattern.",
      "type": "string"
    }
  },
  "required": [
    "literal"
  ]
}
