---
source: crates/contract/tests/schemas.rs
expression: "schema_for! (neighbors::Args)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Args",
  "description": "List the topics connected to one through the relationship graph, without\nranking them.",
  "type": "object",
  "properties": {
    "at": {
      "description": "Only follow edges asserted to hold at this RFC 3339 instant.",
      "type": [
        "string",
        "null"
      ]
    },
    "depth": {
      "description": "How many edges to traverse.",
      "type": "integer",
      "format": "uint8",
      "default": 2,
      "maximum": 4,
      "minimum": 0
    },
    "kinds": {
      "description": "Restrict traversal to one relationship kind. Repeatable.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "topic": {
      "description": "The topic to walk out from.",
      "type": "string"
    }
  },
  "required": [
    "topic"
  ]
}
