---
source: crates/contract/tests/schemas.rs
expression: "schema_for! (sync::Synced)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synced",
  "type": "object",
  "properties": {
    "paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SyncedPath"
      }
    }
  },
  "required": [
    "paths"
  ],
  "$defs": {
    "SyncedPath": {
      "description": "A path an ingest was given, which the server keeps in sync.",
      "type": "object",
      "properties": {
        "error": {
          "description": "Why the last ingest of it failed, if it did.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "state": {
          "description": "How the server is following it: `watching`, `polling` when the\noperating system would not watch it any more, `missing` when it is not\nthere, or `starting` until the server has caught up on it.",
          "type": "string"
        },
        "synced_at": {
          "description": "When the server last finished ingesting what changed under it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "state"
      ]
    }
  }
}
