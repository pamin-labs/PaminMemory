---
source: crates/contract/tests/schemas.rs
expression: "schema_for! (cascade::Failures)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failures",
  "type": "object",
  "properties": {
    "failed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Failure"
      }
    }
  },
  "required": [
    "failed"
  ],
  "$defs": {
    "Failure": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "format": "int32"
        },
        "error": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "job",
        "attempts",
        "error"
      ]
    }
  }
}
