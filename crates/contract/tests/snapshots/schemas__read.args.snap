---
source: crates/contract/tests/schemas.rs
expression: "schema_for! (read::Args)"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Args",
  "description": "Read one topic: its current state, an earlier version, or some of the spans\nof a long memory around a search hit.",
  "type": "object",
  "properties": {
    "around": {
      "description": "With `--span`, this many spans either side as well.",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "span": {
      "description": "Read one span of a memory the index cut into spans, from 0, rather\nthan all of it -- what `pamin-memory search` prints as `--span` on a hit.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "topic": {
      "description": "The topic to read.",
      "type": "string"
    },
    "version_offset": {
      "description": "How many versions back from the current one. Zero is current.",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    }
  },
  "required": [
    "topic"
  ]
}
