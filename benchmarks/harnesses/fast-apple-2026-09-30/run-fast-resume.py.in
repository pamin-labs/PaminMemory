import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import time

root = pathlib.Path('${FAST_EVIDENCE_HOME}')
home = pathlib.Path('${PAMIN_EVAL_HOME}')
repo = pathlib.Path('${EVIDENCE_REPO}')
binary = root / 'fast-coreml-resume-frozen'
source = root / 'coreml-resume/lib.rs'
model = home / 'models/models--cross-encoder--mmarco-mMiniLMv2-L12-H384-v1/snapshots/1427fd652930e4ba29e8149678df786c240d8825/onnx/model.onnx'
binary_sha = 'f0edfbaa28a1cb537cbda6251313d669310193c06a294a58d88c03d62285791b'
source_sha = '01567b01fece03514d7d0a4e0f0103972fcbf1d5c12f2224f5e5ed38ab143712'
model_sha = '3e9a03ed1e966f7c5288dd4230e3d6a9bf5e3a170a06f1f4241c5bca12c6487c'
head = 'bd523771551874fb47f38c70c2cacb6b01bc7b06'

def sha(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()

def memory_free():
    report = subprocess.check_output(['memory_pressure'], text=True)
    return int(report.split('System-wide memory free percentage: ')[1].split('%')[0])

def premises():
    assert shutil.disk_usage(root).free >= 12 * 2**30, 'free disk <12 GiB before start'
    assert memory_free() >= 25, 'system memory free <25% before start'
    assert sha(binary) == binary_sha and sha(source) == source_sha, 'resume binary/source changed'
    assert sha(model) == model_sha, 'FP32 source changed'
    assert subprocess.check_output(['git', '-C', str(repo), 'rev-parse', 'HEAD'], text=True).strip() == head, 'code commit changed'
    assert subprocess.run(['git', '-C', str(repo), 'diff', '--quiet', 'HEAD']).returncode == 0, 'tracked code changed'

premises()
environment = os.environ.copy()
for name in ['HF_HOME', 'TIERS', 'CHANNELS', 'SWEEP', 'FEATURES_OUT', 'PAIRS', 'ROUTES', 'RERANK_RULES', 'PASSAGES', 'PAMIN_RERANK', 'PAMIN_RERANK_DEPTH', 'PAMIN_RERANK_MAX_TOKENS', 'PAMIN_RERANK_BATCH', 'PAMIN_RERANK_BATCH_TOKENS', 'PAMIN_SEARCH_EFFORT', 'PAMIN_PREPARED', 'PAMIN_FUSED_ATTENTION']:
    environment.pop(name, None)
environment.update(PAMIN_EVAL_HOME=str(home), PAMIN_PROFILE='accuracy', PAMIN_VECTOR_INDEX='memory', PAMIN_DEVICE='auto', PAMIN_RESUME_ONLY='1', PAMIN_PRODUCT_ROWS=str(root / 'current-coreml-resume'), DYLD_LIBRARY_PATH=f"{repo / 'target/release'}:${ORT_RUNTIME_DIR}", GIT_CONFIG_COUNT='1', GIT_CONFIG_KEY_0='diff.ignoreSubmodules', GIT_CONFIG_VALUE_0='all')

stdout = root / 'current-coreml-resume.stdout'
stderr = root / 'current-coreml-resume.stderr'
status = root / 'current-resume-status.json'
peak = 0
failure = None
started = time.monotonic()
with stdout.open('w') as out, stderr.open('w') as err:
    proc = subprocess.Popen([str(binary), '--exact', 'search_reaches_across_languages', '--ignored', '--nocapture'], env=environment, stdout=out, stderr=err)
    status.write_text(json.dumps({'state': 'running', 'pid': proc.pid, 'code_head': head, 'binary_sha256': binary_sha, 'source_sha256': source_sha}, indent=2))
    print('started', proc.pid, flush=True)
    last_memory_check = started
    while True:
        done, wait_status, usage = os.wait4(proc.pid, os.WNOHANG)
        if done:
            proc.returncode = os.waitstatus_to_exitcode(wait_status)
            break
        sample = subprocess.run(['ps', '-o', 'rss=', '-p', str(proc.pid)], capture_output=True, text=True)
        if sample.returncode == 0 and sample.stdout.strip():
            peak = max(peak, int(sample.stdout.strip()) * 1024)
        if peak > 8 * 2**30:
            failure = 'process RSS >8 GiB'
        if shutil.disk_usage(root).free < 10 * 2**30:
            failure = 'free disk <10 GiB'
        if time.monotonic() - last_memory_check > 10:
            if memory_free() < 25:
                failure = 'system memory free <25%'
            last_memory_check = time.monotonic()
        if failure:
            proc.terminate()
            _, wait_status, usage = os.wait4(proc.pid, 0)
            proc.returncode = os.waitstatus_to_exitcode(wait_status)
            break
        time.sleep(1)
result = {'state': 'terminal', 'pid': proc.pid, 'exit_code': proc.returncode, 'guard_failure': failure, 'wall_seconds': time.monotonic() - started, 'peak_process_rss_bytes': peak, 'cpu_user_seconds': usage.ru_utime, 'cpu_system_seconds': usage.ru_stime, 'code_head': head, 'binary_sha256': binary_sha, 'source_sha256': source_sha}
status.write_text(json.dumps(result, indent=2))
print('completed', json.dumps(result), flush=True)
assert proc.returncode == 0 and failure is None, 'resume arm rejected'
log = stdout.read_text(errors='replace')
assert 'CoreML resume range: 760..1190 with 10-query overlap' in log
assert 'reranker loaded tier="fast" device="coreml"' in log
assert 'test result: ok. 1 passed' in log
assert sha(binary) == binary_sha and sha(source) == source_sha and sha(model) == model_sha

original = json.loads((root / 'current-coreml-fast.json').read_text())
resumed = json.loads((root / 'current-coreml-resume-fast.json').read_text())
cpu = json.loads((root / 'current-cpu-fast.json').read_text())
assert not original['complete'] and original['completed_queries'] == len(original['rows']) == 770
assert resumed['complete'] and resumed['completed_queries'] == resumed['expected_queries'] == len(resumed['rows']) == 430
assert cpu['complete'] and len(cpu['rows']) == 1190
for index in range(10):
    old, new = original['rows'][760 + index], resumed['rows'][index]
    assert old['query_id'] == new['query_id'] == cpu['rows'][760 + index]['query_id']
    assert all(old[field] == new[field] for field in ['ranking', 'cross_ndcg', 'same_ndcg']), f'overlap ranking differs at {760 + index}'
rows = original['rows'][:760] + resumed['rows']
for index, row in enumerate(rows):
    assert row['query_id'] == cpu['rows'][index]['query_id'], f'query rotation differs at {index}'
    row['index'] = index
merged = {'expected_queries': 1190, 'completed_queries': 1190, 'complete': True, 'boundary': 'Engine search call; two frozen CoreML processes with ten-query overlap verified', 'rows': rows}
output = root / 'current-coreml-fast-merged.json'
output.write_text(json.dumps(merged))
summary = root / 'current-coreml-fast-merged-summary.json'
subprocess.run(['${SCORER}', str(output), '${JUDGMENTS}', str(summary)], check=True, stdout=subprocess.DEVNULL)
print('verified all 1190 CoreML Fast queries with 10 identical overlap rankings', flush=True)
