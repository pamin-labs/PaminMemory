[package]
name = "identifier-diagnostic"
version = "0.0.0"
edition = "2024"

[workspace]

[profile.release]
lto = "thin"
codegen-units = 1
panic = "abort"
strip = "symbols"

[dependencies]
pamin-core = { path = "/workspace/scratch/fusion-pool-prototype-tools/variants/baseline/crates/pamin-core" }
pamin-engine = { path = "/workspace/scratch/fusion-pool-prototype-tools/variants/baseline/crates/pamin-engine" }
pamin-index = { path = "/workspace/scratch/fusion-pool-prototype-tools/variants/baseline/crates/pamin-index" }
pamin-store = { path = "/workspace/scratch/fusion-pool-prototype-tools/variants/baseline/crates/pamin-store" }
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
serde_json = "1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
