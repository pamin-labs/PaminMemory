#!/usr/bin/env python3
"""Read-only metadata-component probe; prints new observations, never product work.

Measurement-only: it asserts no product invariant, so it lives with the other
inert harness sources rather than beside the retained results it reads.
Uses the hash-bound before source retained in the results directory. No
fetch/download, file edits, SDK, database, model, native helper or Cargo
invocation is provided.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import statistics
import time
import sys

ROOT = Path(__file__).resolve().parents[2]/'results/index/native-readonly-metadata-2026-10-01'
# Keep the probe read-only even when invoked without Python -B.
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT))
import verify


def require(condition, message):
    if not condition:
        raise ValueError(message)


def load_before(cost):
    source = (ROOT/'before-verify.py.in').read_bytes()
    require(hashlib.sha256(source).hexdigest() == cost['before_verify_sha256'], 'before source identity differs')
    before = {'__file__': str(ROOT/'verify.py'), '__name__': 'before_metadata_component'}
    exec(compile(source, str(ROOT/'before-verify.py.in'), 'exec'), before)
    return before


def environment(interference):
    # Describe the run that produced these observations, never the historical
    # receipt's host; anything the probe cannot observe is reported as unknown.
    return {'platform': platform.platform(), 'machine': platform.machine(),
            'processor': platform.processor() or 'unknown',
            'python': platform.python_implementation()+' '+platform.python_version(),
            'logical_cpus': os.cpu_count(),
            'load_average_1_5_15': list(os.getloadavg()) if hasattr(os, 'getloadavg') else 'unknown',
            'interference': interference or 'unknown: not declared with --interference'}


def timed(label, function, evidence, cost):
    # Each arm establishes and checks its own cache premise, so its sample does
    # not depend on which arm ran before it in the rotation.
    if label == 'after_cold':
        verify._crc32c_cached.cache_clear()
    elif label == 'after_warm' and verify._crc32c_cached.cache_info().currsize == 0:
        require(function(evidence), 'metadata validation did not complete')
    stats_before = verify._crc32c_cached.cache_info()
    wall = time.perf_counter(); cpu = time.process_time()
    require(function(evidence), 'metadata validation did not complete')
    observed = {'wall_seconds': time.perf_counter()-wall, 'process_cpu_seconds': time.process_time()-cpu}
    stats_after = verify._crc32c_cached.cache_info()
    scans = 16 if label == 'before' else stats_after.misses-stats_before.misses
    require(label != 'after_cold' or scans == 1, 'cold arm did not start from an empty table cache')
    require(label != 'after_warm' or scans == 0, 'warm arm scanned a table')
    observed['scalar_table_bytes'] = scans * cost['table_identity']['bytes_each']
    observed['scalar_table_scans'] = scans
    if label != 'before':
        observed['table_cache_hits'] = stats_after.hits-stats_before.hits
    return observed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--execute', action='store_true', help='opt in to metadata-only observations')
    parser.add_argument('--rounds', type=int, default=7, help='rotated rounds; each runs every arm once')
    parser.add_argument('--interference', help='declared shared-machine interference for this run')
    args = parser.parse_args()
    arms = ['before', 'after_cold', 'after_warm']
    if not args.execute:
        print(f'Plan: {args.rounds} rounds rotating the order of {", ".join(arms)}; '
              'retained before CRC source and current verifier; no product execution.')
        return
    require(args.rounds >= len(arms), 'need at least one full rotation of the arms')
    cost = json.loads((ROOT/'verifier-cost.json').read_text())
    for name, expected in cost['probe_inputs_sha256'].items():
        require(hashlib.sha256((ROOT/name).read_bytes()).hexdigest() == expected, 'recorded input/source identity differs: ' + name)
    before = load_before(cost)
    evidence = verify.source_binding.load_json(ROOT/'evidence.json')
    tables = set()
    excerpts = 0
    for run in evidence['runs']:
        for file in run['files']:
            for excerpt in file['excerpts'].values():
                data = bytearray(excerpt['table_size'])
                for offset, text in excerpt['table_nonzero_runs']:
                    block = bytes.fromhex(text)
                    data[offset:offset+len(block)] = block
                tables.add(bytes(data)); excerpts += 1
    require(excerpts == 16 and len(tables) == 1, 'retained table inventory differs')
    table = next(iter(tables))
    require(len(table) == cost['table_identity']['bytes_each']
            and hashlib.sha256(table).hexdigest() == cost['table_identity']['sha256'], 'retained table bytes differ')
    del tables, table, data
    functions = {'before': before['verify'], 'after_cold': verify.verify, 'after_warm': verify.verify}
    started = environment(args.interference)
    samples = {arm: [] for arm in arms}
    orders = []
    for round_index in range(args.rounds):
        order = arms[round_index % len(arms):]+arms[:round_index % len(arms)]
        orders.append(order)
        for arm in order:
            samples[arm].append(timed(arm, functions[arm], evidence, cost))
    summary = {arm: {metric: {'median': statistics.median(s[metric] for s in rows),
                              'min': min(s[metric] for s in rows), 'max': max(s[metric] for s in rows)}
                     for metric in ['wall_seconds', 'process_cpu_seconds']}
               for arm, rows in samples.items()}
    print(json.dumps({'new_observations': samples, 'summary': summary, 'orders': orders,
                      'environment': {'at_start': started, 'at_end': environment(args.interference)},
                      'scope': f'{args.rounds} rotated in-process rounds of metadata verification; '
                               'process RSS not measured; no product-search claim',
                      'scan_scope': cost['scan_scope']}, indent=2))


if __name__ == '__main__':
    main()
