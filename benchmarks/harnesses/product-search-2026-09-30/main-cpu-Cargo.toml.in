[package]
name = "pamin-product-main"
version = "0.1.0"
edition = "2024"
[lib]
path = "lib.rs"
[dependencies]
pamin-core = { path = "${MAIN_REPO}/crates/pamin-core" }
pamin-engine = { path = "${MAIN_REPO}/crates/pamin-engine" }
pamin-index = { path = "${MAIN_REPO}/crates/pamin-index" }
pamin-store = { path = "${MAIN_REPO}/crates/pamin-store" }
anyhow = "1"
time = { version = "0.3", features = ["serde-well-known"] }
tracing = "0.1"
uuid = { version = "1", features = ["v7", "serde"] }
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread", "sync", "time"] }
sha2 = "0.10"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
hf-hub = { version = "0.5", default-features = false, features = ["native-tls"] }
sqlx = { version = "0.9", default-features = false, features = ["runtime-tokio", "tls-native-tls", "postgres", "migrate", "derive", "uuid", "time", "json"] }
serde = { version = "1", features = ["derive"] }
serde_json = { version = "1", features = ["raw_value"] }
tempfile = "3"
[profile.release]
lto = "thin"
codegen-units = 1
strip = true
panic = "abort"
