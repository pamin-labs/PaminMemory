// Materialize beside the public retrieval scaffold in a fresh scratch export.
#[tokio::test(flavor = "multi_thread")]
#[ignore = "explicit offline synthetic fixture creation"]
async fn synthetic_cache_seed() {
    assert_eq!(std::env::var("PAMIN_DEVICE").as_deref(), Ok("cpu"));
    assert_eq!(std::env::var("PAMIN_PROFILE").as_deref(), Ok("accuracy"));
    let home = std::env::var("PAMIN_EVAL_HOME").unwrap();
    let corpus: Vec<Memory> = load("memories.json");
    let queries: Vec<Query> = load("queries.json");
    assert_eq!((corpus.len(), queries.len()), (230, 157));
    let workspace = Workspace::at(home);
    let project = format!("eval-accuracy-{}", fingerprint(&corpus));
    let mut engine = Engine::open(
        &workspace, &project, Profile::Accuracy, VectorIndex::Memory,
        Access::ReadWrite,
    ).await.unwrap();
    write_corpus(&mut engine, &corpus).await;
    assert_eq!(engine.indexed_documents().unwrap(), 230);
    assert_eq!(engine.vector_index_completeness().unwrap(), 0.0);
    assert_eq!(channels::live_edges(&engine).await, vec![("mentions".into(), 11)]);
    drop(engine);
    pamin_store::database::stop(&workspace).await.unwrap();
    println!("SYNTHETIC_SEED_OK");
}
