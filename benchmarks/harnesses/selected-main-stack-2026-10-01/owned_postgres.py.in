#!/usr/bin/env python3
"""Ownership gate for a newly materialized, exclusive synthetic reproduction."""
import json
import os
from pathlib import Path
import shlex
import socket
import subprocess
import time

NATIVE_SETTINGS={'fsync':'on','synchronous_commit':'off','max_connections':'300','work_mem':'32MB','jit':'off','autovacuum_vacuum_scale_factor':'0.02','random_page_cost':'1.1'}


def require(ok,message):
    if not ok:raise RuntimeError(message)


def layout(home,require_disposable=True):
    home=Path(home).resolve()
    if require_disposable:require((home/'.graph-disposable-clone').is_file(),'not an owned disposable clone')
    record=json.loads((home/'server.json').read_text())
    require(record['host'] in {'localhost','127.0.0.1'},'non-loopback PostgreSQL record')
    require(type(record['port']) is int and 1<=record['port']<=65535,'invalid PostgreSQL port')
    data=(home/'postgres/data').resolve()
    require(data.is_relative_to(home) and (data/'PG_VERSION').is_file(),'owned initialized data absent')
    installs=list((home/'postgres/install').glob('*/bin/pg_ctl'))
    require(len(installs)==1,'ambiguous owned PostgreSQL installation')
    install=installs[0].parent.parent.resolve()
    require(install.is_relative_to(home),'PostgreSQL installation escapes clone')
    require(install.name==Path(record['installation_dir']).name,'copied PostgreSQL installation version differs')
    for name in ['pg_ctl','postgres','psql']:
        require((install/'bin'/name).resolve().is_relative_to(home) and (install/'bin'/name).is_file(),'owned PostgreSQL executable absent')
    return {'home':home,'data':data,'install':install,'record':record}


def family_listening(port,family,address):
    try:
        with socket.socket(family,socket.SOCK_STREAM) as client:
            client.settimeout(.2)
            return client.connect_ex((address,port))==0
    except OSError:return False

def listening(port):
    return family_listening(port,socket.AF_INET,'127.0.0.1') or family_listening(port,socket.AF_INET6,'::1')

def preflight(home):
    item=layout(home)
    require(not (item['data']/'postmaster.pid').exists(),'PostgreSQL pid file already present')
    require(not owned_processes(item),'owned PostgreSQL processes survive without pid file')
    require(not listening(item['record']['port']),'copied PostgreSQL port already bound')
    return item


def process_info(pid):
    proc=Path('/proc')/str(pid)
    stat=(proc/'stat').read_text();fields=stat[stat.rfind(')')+2:].split()
    status=(proc/'status').read_text();uids=[int(v) for v in next(line for line in status.splitlines() if line.startswith('Uid:')).split()[1:]]
    require(len(uids)==4,'truncated process UID record')
    return {'exe':(proc/'exe').resolve(),'argv':(proc/'cmdline').read_bytes().split(b'\0')[:-1],'start_ticks':int(fields[19]),'state':fields[0],'uids':uids}


def identity(item):
    lines=(item['data']/'postmaster.pid').read_text().splitlines()
    require(len(lines)>=4,'truncated PostgreSQL pid record')
    pid=int(lines[0]);require(pid>1,'invalid owned PostgreSQL PID')
    require(Path(lines[1]).resolve()==item['data'],'PostgreSQL pid file belongs to another data directory')
    require(int(lines[3])==item['record']['port'],'PostgreSQL pid file port differs')
    info=process_info(pid)
    require(info['state']!='Z' and info['exe']==(item['install']/'bin/postgres').resolve(),'PostgreSQL PID executable is not owned')
    require(item['data'].stat().st_uid==os.geteuid() and info['uids']==[os.geteuid()]*4,'PostgreSQL UID is not the controller/clone owner')
    argv=[arg.decode(errors='strict') for arg in info['argv']]
    require('-D' in argv and argv.index('-D')+1<len(argv),'owned PostgreSQL has no data argument')
    require(Path(argv[argv.index('-D')+1]).resolve()==item['data'],'PostgreSQL PID command points outside clone')
    return {'pid':pid,'start_ticks':info['start_ticks'],'data_directory':str(item['data']),'port':item['record']['port'],'postgres_executable':str(info['exe']),'uids':info['uids'],'data_owner_uid':item['data'].stat().st_uid}


def client_environment(item,base):
    env={k:v for k,v in base.items() if not k.startswith('PG')}
    record=item['record'];env.update(PGHOST='127.0.0.1',PGPORT=str(record['port']),PGUSER=record['username'],PGPASSWORD=record['password'],PGDATABASE=record['database'],PGCONNECT_TIMEOUT='3')
    return env


def show_data_directory(item,base):
    result=subprocess.run([str(item['install']/'bin/psql'),'-XAt','-v','ON_ERROR_STOP=1','-c','SHOW data_directory'],env=client_environment(item,base),capture_output=True,text=True,timeout=5,check=True)
    require(Path(result.stdout.strip()).resolve()==item['data'],'authenticated SHOW data_directory is not the owned clone')
    return str(item['data'])


def start(home,base):
    item=preflight(home)
    options=['-p',str(item['record']['port']),'-h','127.0.0.1']
    for key,value in NATIVE_SETTINGS.items():options += ['-c',f'{key}={value}']
    command=[str(item['install']/'bin/pg_ctl'),'-D',str(item['data']),'-l',str(item['home']/'postgres/graph-owned-start.log'),'-o',shlex.join(options),'-w','-t','30','start']
    subprocess.run(command,env=base,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=35,check=True)
    recorded=identity(item);require(listening(recorded['port']),'owned PostgreSQL did not listen')
    show_data_directory(item,base)
    # Capture actual selected resource settings, excluding credentials.
    settings={}
    for key in NATIVE_SETTINGS:
        result=subprocess.run([str(item['install']/'bin/psql'),'-XAt','-v','ON_ERROR_STOP=1','-c',f'SHOW {key}'],env=client_environment(item,base),capture_output=True,text=True,timeout=5,check=True)
        settings[key]=result.stdout.strip()
    require(settings==NATIVE_SETTINGS,'actual PostgreSQL defaults differ from native frozen source settings')
    return {'identity':recorded,'data_directory_verified_before_native_fixture':True,'native_settings':settings}


def check(home,expected):
    actual=identity(layout(home));require(actual==expected,'owned PostgreSQL PID/data/port/executable changed')
    require(not family_listening(actual['port'],socket.AF_INET6,'::1'),'unexpected IPv6 sibling listener at copied native localhost port')
    return actual


def owned_processes(item):
    result=[]
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit():continue
        try:info=process_info(int(entry.name))
        except (FileNotFoundError,ProcessLookupError,PermissionError):continue
        if info['state']!='Z' and info['exe']==(item['install']/'bin/postgres').resolve():
            result.append({'pid':int(entry.name),'start_ticks':info['start_ticks'],'uids':info['uids']})
    return result

def stop(home,base,expected=None):
    item=layout(home);pidfile=item['data']/'postmaster.pid'
    if not pidfile.exists():
        require(not listening(item['record']['port']),'port remains bound without owned pid proof')
        require(not owned_processes(item),'owned PostgreSQL process remains without pid file')
        return {'already_stopped':True}
    owned=identity(item)
    if expected is not None:require(owned==expected,'will not stop a different PostgreSQL PID')
    command=[str(item['install']/'bin/pg_ctl'),'-D',str(item['data']),'-m','fast','-w','-t','20','stop']
    fallback=False
    try:subprocess.run(command,env=base,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=25,check=True)
    except (subprocess.TimeoutExpired,subprocess.CalledProcessError):
        require(identity(item)==owned, 'will not fallback-stop a changed PostgreSQL PID')
        fallback=True
        command=[str(item['install']/'bin/pg_ctl'),'-D',str(item['data']),'-m','immediate','-w','-t','10','stop']
        subprocess.run(command,env=base,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=15,check=True)
    deadline=time.monotonic()+5
    while time.monotonic()<deadline:
        try:info=process_info(owned['pid']);alive=info['state']!='Z' and info['start_ticks']==owned['start_ticks']
        except (FileNotFoundError,ProcessLookupError):alive=False
        if not alive and not pidfile.exists() and not listening(owned['port']) and not owned_processes(item):return {'owned_pid':owned['pid'],'process_pidfile_and_port_gone':True,'immediate_fallback':fallback}
        time.sleep(.1)
    raise RuntimeError('owned PostgreSQL process/pidfile/port did not disappear after bounded stop')
