#!/usr/bin/env python3
"""Tiny private fake-fixture checks only: no PostgreSQL, models or builds."""
import importlib.machinery,importlib.util,json,os,shutil,stat,sys,tempfile,types
from datetime import datetime,timezone
from pathlib import Path
if sys.flags.optimize:raise SystemExit('Negative guard checks require assertions; remove -O/PYTHONOPTIMIZE')
sys.dont_write_bytecode=True
loader=importlib.machinery.SourceFileLoader('fixture_guards',str(Path(__file__).with_name('run-guarded.py.in')))
spec=importlib.util.spec_from_loader(loader.name,loader);guard=importlib.util.module_from_spec(spec);loader.exec_module(guard)
def refuse(operation):
    try:operation()
    except (AssertionError,RuntimeError):return
    raise AssertionError('negative case passed')
def case(kind='normal',copies=9):
    with tempfile.TemporaryDirectory() as temporary:
        root=Path(temporary);seed=root/'seed';models=root/'models';models.mkdir();(models/'prepared').mkdir();(models/'snapshot').mkdir()
        for name in ['source','snapshot/tokenizer','prepared/model.onnx','prepared/model.onnx.data','prepared/attention.unfused','prepared/reranker.onnx','prepared/alternate.onnx']:(models/name).write_bytes(b'fake model asset')
        model_plan={'version':1,'selection_provenance':'fake executable selection only','models':[{'name':'embedding','asset_directories':['snapshot','prepared'],'load_graph':'prepared/model.onnx','assets':{'source':['source'],'tokenizer':['snapshot/tokenizer'],'prepared_graph':['prepared/model.onnx','prepared/alternate.onnx'],'external_weights':['prepared/model.onnx.data'],'metadata':['prepared/attention.unfused']},'graph_external_weights':{name:['prepared/model.onnx.data'] for name in ['prepared/model.onnx','prepared/alternate.onnx']}}]}
        second=json.loads(json.dumps(model_plan['models'][0]));second['name']='reranker';second['load_graph']='prepared/reranker.onnx';second['assets']['prepared_graph'].append('prepared/reranker.onnx');second['graph_external_weights']['prepared/reranker.onnx']=['prepared/model.onnx.data'];model_plan['models'][0]['assets']['prepared_graph'].append('prepared/reranker.onnx');model_plan['models'][0]['graph_external_weights']['prepared/reranker.onnx']=['prepared/model.onnx.data'];model_plan['models'].append(second)
        model_manifest=root/'models.json';model_manifest.write_text(json.dumps(guard.MODEL['prepare'](models,model_plan)));model_manifest.chmod(0o600)
        (seed/'postgres/data/nested').mkdir(parents=True);(seed/'index').mkdir()
        (seed/'postgres/data/nested/data').write_bytes(b'fake stopped data')
        (seed/'index/data').write_bytes(b'fake index');(seed/'server.json').write_bytes(b'fake private configuration')
        (seed/'models').symlink_to(models,target_is_directory=True)
        expected=guard.fixture_snapshot(seed,models)
        manifest=root/'expected.json';manifest.write_text(json.dumps({'recorded_utc':datetime.now(timezone.utc).isoformat(),'fixture':expected}));manifest.chmod(0o600)
        executable=root/'binary';executable.write_bytes(b'never executed')
        libs=root/'libs';libs.mkdir();library=libs/'libfake.so';library.write_bytes(b'fake native bytes')
        native=guard.NATIVE['snapshot']([str(libs)],[str(libs)])
        names=['predecessor','candidate','main'];arms=[f'{name},{name},{executable}' for name in names]
        restart_source='crates/pamin-engine/tests/scratch_restart_floor.rs'
        helper={'scratch_source':restart_source,'scratch_sha256':'fake-harness','checkout':str(root),
                'inputs_before':{restart_source:{'sha256':'fake-harness'}},'inputs_after':{restart_source:{'sha256':'fake-harness'}},
                'compiler_artifacts':[{'target':{'name':'scratch_restart_floor','src_path':str(root/restart_source)},'executable':str(executable),'fresh':False}]}
        attestation=root/'attestation.json';attestation.write_text(json.dumps({'scope':'prospective build-time inputs/outputs only; no historical binary binding','native_loader_inputs':native,'build_kind':'restart-trial','scratch_target':restart_source,'harness_sha256':'fake-harness','arms':{name:dict(helper,**{'commit':name,'binary':str(executable),'binary_sha256':guard.digest(executable),'binary_bytes':executable.stat().st_size}) for name in names}}))
        output=root/'copies';record=root/'record.json'
        original_copy=shutil.copytree;original_load=guard.load_runner;original_argv=sys.argv;original_env=dict(os.environ)
        def altered_copy(source,destination,*args,**kwargs):
            result=original_copy(source,destination,*args,**kwargs)
            if Path(source).resolve()!=seed:return result
            clone=Path(destination)
            if kind=='clone_change':(clone/'index/data').write_bytes(b'changed')
            elif kind=='source_change':(seed/'index/data').write_bytes(b'changed')
            elif kind=='shared_inode':
                (clone/'index/data').unlink();os.link(seed/'index/data',clone/'index/data')
            elif kind=='external_link':
                (clone/'index/data').unlink();(clone/'index/data').symlink_to(seed/'index/data')
            elif kind=='binary_change':executable.write_bytes(b'changed binary')
            elif kind=='model_prearm_change':(models/'prepared/model.onnx').write_bytes(b'changed before launch')
            return result
        def fake_main():
            output.mkdir();sequence=[(rep,arm.split(',',2)) for rep in range(3) for arm in arms[rep:]+arms[:rep]]
            if copies==10:sequence.append((3,arms[0].split(',',2)))
            for index,(rep,(name,_,_)) in enumerate(sequence[:copies]):
                shutil.copytree(seed,output/f'{rep}-{name}',symlinks=True)
                runner.subprocess.run([str(executable)],env={})
                if kind=='native_change':library.write_bytes(b'changed native bytes')
                if kind=='model_graph_change':(models/'prepared/model.onnx').write_bytes(b'changed during arm')
                if kind=='model_weight_change':(models/'prepared/model.onnx.data').write_bytes(b'changed during arm')
                runner.cpu_provider_assignments('fake retained log')
                if kind=='late_failure' and index==1:raise RuntimeError('fake late failure')
            if kind=='post_source_change':(seed/'index/data').write_bytes(b'changed after copies')
        def provider(log):
            actual={role:{'model_graph':str(models/('prepared/model.onnx' if role=='embedding' else 'prepared/reranker.onnx')),'assigned_nodes':{'CPUExecutionProvider':1}} for role in ['embedding','reranker']}
            if kind=='empty_providers':return {}
            if kind=='missing_role':actual.pop('reranker')
            if kind=='wrong_graph':actual['embedding']['model_graph']=str(models/'prepared/alternate.onnx')
            if kind=='swapped_roles':actual['embedding'],actual['reranker']=actual['reranker'],actual['embedding']
            if kind=='non_cpu':actual['embedding']['assigned_nodes']={'CUDAExecutionProvider':1}
            return actual
        def launch(command,**kwargs):
            assert command[0].startswith('/proc/self/fd/')
            fd=int(command[0].rsplit('/',1)[1]);assert fd in kwargs['pass_fds']
            assert os.pread(fd,100,0)==b'never executed'
            return types.SimpleNamespace(returncode=0)
        runner=types.SimpleNamespace(shutil=shutil,main=fake_main,cpu_provider_assignments=provider,subprocess=types.SimpleNamespace(run=launch))
        try:
            shutil.copytree=altered_copy;guard.load_runner=lambda path:runner
            os.environ.clear();os.environ.update({key:value for key,value in original_env.items() if not key.startswith('PAMIN_') and key not in {'HF_HOME','HF_HUB_CACHE'}})
            sys.argv=['run-guarded.py.in','--attestation',str(attestation),'--model-manifest',str(model_manifest),'--record',str(record),'--documents','18000','--index','disk','trials','--seed',str(seed),'--output',str(output),'--fixture-manifest',str(manifest)]
            for arm in arms:sys.argv+=['--arm',arm]
            before_env=dict(os.environ);before_argv=sys.argv
            if kind=='normal' and copies==9:
                guard.main();data=json.loads(record.read_text());assert data['status']=='finished' and len(data['copies'])==9 and len(data['native_after_arms'])==9 and len(data['models_after_arms'])==9
                assert all(row['clone']==row['source'] and row['independent_regular_files'] for row in data['copies'])
                assert len(data['copies'])==9, 'recursive subtree copies must not generate duplicate attestations'
                assert isinstance(data['fixture_before_trials']['entries'],int), 'credential/path content map must stay out of safe aggregate record'
            else:
                refuse(guard.main);data=json.loads(record.read_text());assert data['status']=='failed' and len(data.get('copies',[]))<=9
                if kind=='native_change':library.write_bytes(b'changed native bytes')
                runner.cpu_provider_assignments('fake retained log')
                if kind=='late_failure':assert len(data['copies'])==2
            assert stat.S_IMODE(record.stat().st_mode)==0o600
            assert runner.cpu_provider_assignments is provider
            assert shutil.copytree is altered_copy and sys.argv is before_argv and dict(os.environ)==before_env, 'scope not restored'
        finally:
            shutil.copytree=original_copy;guard.load_runner=original_load;sys.argv=original_argv
            os.environ.clear();os.environ.update(original_env)
for kind in ['normal','clone_change','source_change','shared_inode','external_link','binary_change','late_failure','post_source_change','native_change','model_prearm_change','model_graph_change','model_weight_change','empty_providers','missing_role','wrong_graph','swapped_roles','non_cpu']:
    case(kind);print('passed',kind)
case(copies=8);case(copies=10);print('passed exact nine-copy count')
for key in ['HF_HOME','HF_HUB_CACHE']:refuse(lambda:guard.controlled_environment({key:'unexpected'}))
for value in ['','1','64']:refuse(lambda:guard.controlled_environment({'TOKIO_WORKER_THREADS':value}))
assert guard.controlled_environment({})['TOKIO_WORKER_THREADS']=='4'
for key in ['TOKENIZERS_PARALLELISM','RAYON_NUM_THREADS']:
    for value in ['','false','1','64']:refuse(lambda:guard.controlled_environment({key:value}))
assert guard.controlled_environment({})['TOKENIZERS_PARALLELISM']=='false'
assert guard.controlled_environment({})['RAYON_NUM_THREADS']=='4'
with tempfile.TemporaryDirectory() as temporary:
    root=Path(temporary);seed=root/'seed';models=root/'models';models.mkdir();(seed/'postgres/data').mkdir(parents=True);(seed/'index').mkdir();(seed/'models').symlink_to(models,target_is_directory=True)
    (seed/'index/data').write_bytes(b'original');expected=guard.fixture_snapshot(seed,models)
    (seed/'index/data').write_bytes(b'changed before first copy');refuse(lambda:guard.verify_fixture(seed,expected))
    (seed/'postgres/data/postmaster.pid').write_text('fake');refuse(lambda:guard.fixture_snapshot(seed,models))
print('passed inherited cache override, pre-copy mutation, running source guards; no real trial executed')

for key in ['MALLOC_ARENA_MAX','MALLOC_TRIM_THRESHOLD_','MALLOC_MMAP_THRESHOLD_','MALLOC_CHECK_','MALLOC_FUTURE_CONTROL','GLIBC_TUNABLES']:
    for value in ['','0','32']:refuse(lambda:guard.controlled_environment({key:value}))
assert not any(key.startswith('MALLOC_') or key=='GLIBC_TUNABLES' for key in guard.controlled_environment({}))
print('passed inherited allocator controls including empty values; default allocator environment unchanged')
