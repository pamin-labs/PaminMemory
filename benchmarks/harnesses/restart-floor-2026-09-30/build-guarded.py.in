#!/usr/bin/env python3
"""Prospective builds only; preserve archived build.py.in and historical outputs."""
import argparse,hashlib,json,os,shutil,subprocess,sys
from datetime import datetime,timezone
from pathlib import Path
if sys.flags.optimize:raise SystemExit('Build guards require assertions; remove -O/PYTHONOPTIMIZE')

TARGET='crates/pamin-engine/tests/scratch_restart_floor.rs'
PRODUCTS={'pamin-core','pamin-store','pamin-index','pamin-engine'}
def digest(path):
    h=hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda:stream.read(4*1024*1024),b''):h.update(block)
    return h.hexdigest()
def git(checkout,*args):
    return subprocess.check_output(['git',*args],cwd=checkout)
def inputs(checkout,commit,allowed):
    assert git(checkout,'rev-parse','HEAD').decode().strip()==commit
    assert not git(checkout,'status','--porcelain','--untracked-files=no'), 'tracked changes refused'
    staged=git(checkout,'ls-files','--stage','-z').decode().split('\0')[:-1]
    tracked={entry.split('\t',1)[1]:entry.split('\t',1)[0].split() for entry in staged}
    assert TARGET not in tracked, 'scratch target must remain untracked'
    extra=set()
    for options in [[],['--ignored']]:
        extra.update(git(checkout,'ls-files','--others',*options,'--exclude-standard','-z').decode().split('\0')[:-1])
    assert extra<=set(allowed), 'unexpected untracked/ignored source or dependency'
    for name in extra:assert digest(checkout/name)==allowed[name], 'scratch content differs from explicit manifest'
    result={}
    for name in sorted(set(tracked)|extra):
        if name in tracked and tracked[name][0]=='160000':
            result[name]={'kind':'gitlink','commit':tracked[name][1]};continue
        path=checkout/name
        assert path.is_file() and not path.is_symlink(), 'non-file/symlink source requires separate explicit audit'
        result[name]={'bytes':path.stat().st_size,'sha256':digest(path)}
    assert 'Cargo.lock' in result and 'Cargo.toml' in result
    return result
def fresh_artifacts(records,checkout):
    selected=[x for x in records if x.get('reason')=='compiler-artifact' and x.get('target',{}).get('name','').replace('_','-') in PRODUCTS|{'scratch-restart-floor'}]
    assert {x['target']['name'].replace('_','-') for x in selected}==PRODUCTS|{'scratch-restart-floor'}
    for x in selected:
        assert x['fresh'] is False, 'product/helper reused'
        assert Path(x['manifest_path']).resolve().is_relative_to(checkout.resolve()), 'product compiled from another checkout'
    tests=[x for x in selected if x['target']['name']=='scratch_restart_floor' and x.get('executable')]
    assert len(tests)==1 and any(x.get('reason')=='build-finished' and x['success'] is True for x in records)
    return selected,Path(tests[0]['executable'])
def main():
    parser=argparse.ArgumentParser(description='New source-attested restart builds; never historical certification')
    parser.add_argument('--plan',type=Path,required=True)
    parser.add_argument('--output',type=Path,required=True)
    args=parser.parse_args();plan=json.loads(args.plan.read_text())
    assert not args.output.exists(), 'preserve all prior outputs'
    assert set(plan['arms'])=={'main','predecessor','candidate'}
    harness=Path(plan['harness']);assert digest(harness)==plan['harness_sha256']
    # Only this exact ignored integration-test file is allowed; no directory
    # exclusions that could hide a modified dependency or other build input.
    for arm in plan['arms'].values():
        assert arm['allowed_untracked']=={TARGET:plan['harness_sha256']}
        inputs(Path(arm['checkout']),arm['commit'],arm['allowed_untracked'])
    env=dict(os.environ,RUSTUP_HOME='/workspace/.rustup',CARGO_HOME='/workspace/.cargo',
             CARGO_TARGET_DIR='/workspace/PaminMemory/target',CARGO_BUILD_JOBS='4',
             ORT_LIB_LOCATION='/workspace/.onnxruntime/onnxruntime-linux-x64-1.28.0/lib',ORT_PREFER_DYNAMIC_LINK='1')
    env['PATH']='/workspace/.cargo/bin:'+env['PATH']
    args.output.mkdir()
    audit={'recorded_utc':datetime.now(timezone.utc).isoformat(),
           'scope':'prospective build-time inputs/outputs only; no historical binary binding',
           'plan_sha256':digest(args.plan),'harness_sha256':digest(harness),
           'toolchain':subprocess.check_output(['rustc','+1.98.1','-Vv'],env=env,text=True),
           'cargo':subprocess.check_output(['cargo','+1.98.1','-V'],env=env,text=True),
           'build_environment':{key:env.get(key) for key in ['RUSTUP_HOME','CARGO_HOME','CARGO_TARGET_DIR','CARGO_BUILD_JOBS','ORT_LIB_LOCATION','ORT_PREFER_DYNAMIC_LINK','RUSTFLAGS','CARGO_ENCODED_RUSTFLAGS','RUSTC_WRAPPER','RUSTC_WORKSPACE_WRAPPER']},'arms':{}}
    for name in ['main','predecessor','candidate']:
        arm=plan['arms'][name];checkout=Path(arm['checkout'])
        shutil.copyfile(harness,checkout/TARGET)
        before=inputs(checkout,arm['commit'],arm['allowed_untracked'])
        command=['cargo','+1.98.1','test','-p','pamin-engine','--test','scratch_restart_floor','--no-run','--release','--offline','--locked','--message-format=json']
        outpath=args.output/f'{name}.jsonl';errpath=args.output/f'{name}.log'
        with outpath.open('w') as out,errpath.open('w') as err:
            subprocess.run(['cargo','+1.98.1','clean','--release',*[item for product in sorted(PRODUCTS) for item in ['-p',product]]],cwd=checkout,env=env,stdout=err,stderr=err,check=True)
            subprocess.run(command,cwd=checkout,env=env,stdout=out,stderr=err,check=True)
        after=inputs(checkout,arm['commit'],arm['allowed_untracked']);assert before==after
        selected,executable=fresh_artifacts([json.loads(line) for line in outpath.read_text().splitlines() if line.startswith('{')],checkout)
        frozen=args.output/name;shutil.copy2(executable,frozen)
        assert digest(frozen)==digest(executable)
        audit['arms'][name]={'commit':arm['commit'],'checkout':str(checkout),'inputs_before':before,'inputs_after':after,
                            'command':command,'compiler_artifacts':selected,'stdout_sha256':digest(outpath),'stderr_sha256':digest(errpath),
                            'binary':str(frozen.resolve()),'binary_sha256':digest(frozen),'binary_bytes':frozen.stat().st_size}
        (args.output/'build-attestation.json').write_text(json.dumps(audit,indent=2)+'\n')
if __name__=='__main__':main()
