"""Prospective Linux executable-FD binding; byte/inode endpoints, not immutability."""
from contextlib import contextmanager
import hashlib
import os
from pathlib import Path
import shutil
import stat
import tempfile


def digest_fd(descriptor):
    result=hashlib.sha256();offset=0
    while True:
        block=os.pread(descriptor,1024*1024,offset)
        if not block:break
        result.update(block);offset+=len(block)
    return result.hexdigest()


def verify(entry):
    info=os.fstat(entry['fd'])
    assert [info.st_dev,info.st_ino]==entry['device_inode'], 'opened executable inode changed'
    assert stat.S_IMODE(info.st_mode)==0o500 and info.st_size==entry['bytes'] and digest_fd(entry['fd'])==entry['sha256'], 'opened executable bytes/mode changed'
    return {key:entry[key] for key in ['path','sha256','bytes','device_inode']}


def invocation(command,entry,kwargs=None):
    # Execute the already-open inode even if its private pathname is replaced.
    kwargs={} if kwargs is None else dict(kwargs)
    assert not kwargs.get('shell',False), 'executable binding requires direct invocation'
    command=list(command);command[0]='/proc/self/fd/'+str(entry['fd'])
    kwargs['pass_fds']=tuple(sorted(set(kwargs.get('pass_fds',()))|{entry['fd']}))
    return command,kwargs


@contextmanager
def copies(sources,identities,parent,excluded=()):
    parent=Path(parent).resolve()
    assert all(not parent.is_relative_to(Path(root).resolve()) for root in excluded), 'private executable copies must remain outside measured fixtures'
    descriptors=[]
    with tempfile.TemporaryDirectory(prefix='restart-executable-',dir=parent) as directory:
        os.chmod(directory,0o700);entries={}
        try:
            for index,(name,source) in enumerate(sources.items()):
                path=Path(directory)/str(index)
                with Path(source).open('rb') as original,path.open('xb') as target:shutil.copyfileobj(original,target,1024*1024)
                path.chmod(0o500);descriptor=os.open(path,os.O_RDONLY);descriptors.append(descriptor)
                info=os.fstat(descriptor);expected=identities[name]
                entry={'fd':descriptor,'path':str(path),'sha256':expected['sha256'],'bytes':expected['bytes'],'device_inode':[info.st_dev,info.st_ino]}
                verify(entry);entries[name]=entry
            yield entries
        finally:
            for descriptor in descriptors:os.close(descriptor)
