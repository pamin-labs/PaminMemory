"""Tiny prospective identity mocks, no native process or product execution."""
import ast,hashlib,json,os,runpy,subprocess,sys,tempfile
from pathlib import Path
from unittest.mock import patch
sys.dont_write_bytecode=True
root=Path(__file__).resolve().parent;repo=root.parents[2]
before='--before' in sys.argv;base='3a84478496fcfb0e225c9fe65c54c41b8ada1679'
source=root/'run-guarded.py.in';text=source.read_text()
if before:text=subprocess.check_output(['git','show',base+':'+str(source.relative_to(repo))],cwd=repo,text=True)
g={'__file__':str(source),'__name__':'fixture'};exec(compile(text,str(source),'exec'),g)
with tempfile.TemporaryDirectory() as tmp:
 p=Path(tmp);att=p/'attestation.json';first=b'{"commit":"first"}';second=b'{"commit":"second"}'
 att.write_bytes(first)
 if before:
  original=Path.read_text
  def read(path,*args,**kwargs):
   value=original(path,*args,**kwargs)
   if path==att:att.write_bytes(second)
   return value
  with patch.object(Path,'read_text',read):value=json.loads(att.read_text());digest=g['digest'](att)
  assert value['commit']=='first' and digest==hashlib.sha256(second).hexdigest()
 else:
  original=Path.read_bytes
  def read(path):
   value=original(path)
   if path==att:att.write_bytes(second)
   return value
  with patch.object(Path,'read_bytes',read):value,digest=g['read_attestation'](att)
  assert value['commit']=='first' and digest==hashlib.sha256(first).hexdigest()
  tree=ast.parse(text);main=next(x for x in tree.body if isinstance(x,ast.FunctionDef) and x.name=='main')
  assert any(isinstance(x,ast.Call) and isinstance(x.func,ast.Name) and x.func.id=='read_attestation' for x in ast.walk(main))
  assert not any(isinstance(x,ast.Call) and isinstance(x.func,ast.Name) and x.func.id=='digest' and ast.unparse(x.args[0])=='a.attestation' for x in ast.walk(main))
print('BEFORE: attestation parsed/hash bytes diverge' if before else 'PASS: attestation hash binds parsed bytes')
