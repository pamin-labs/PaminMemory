+#[tokio::test(flavor = "multi_thread")]
+#[ignore = "paired product-path FP64 validation on the complete cached MIRACL index"]
+async fn scratch_fp64_miracl() {
+    use pamin_index::Profile;
+    use pamin_index::projection::{experimental_candidates, experimental_math};
+    assert!(std::env::var_os("HF_HOME").is_none());
+    let corpus = Corpus::load();
+    assert!(!corpus.capped);
+    assert_eq!(corpus.queries.len(), 482);
+    let workspace = Workspace::at(std::env::var("PAMIN_EVAL_HOME").unwrap());
+    let mut selected = None;
+    for (named, profile) in [("accuracy", Profile::Accuracy), ("speed", Profile::Speed)] {
+        let project = format!("miracl-sw-{named}-{}", corpus.fingerprint());
+        let opened = Engine::open(
+            &workspace,
+            &project,
+            profile,
+            VectorIndex::Memory,
+            Access::ReadWrite,
+        )
+        .await;
+        if let Ok(engine) = opened {
+            let count = engine.indexed_documents().unwrap();
+            if count == corpus.passages.len() as u64
+                && engine.vector_index_completeness().unwrap() == 1.0
+            {
+                selected = Some((named, project, engine));
+                break;
+            }
+        }
+    }
+    let (named, project, engine) = selected.expect(
+        "a complete cached MIRACL index is required; no reindex/download during validation",
+    );
+    println!(
+        "FP64 MIRACL reused {project}, profile {named}, {} documents",
+        corpus.passages.len()
+    );
+    let mut output = Vec::new();
+    for (index, query) in corpus.queries.iter().enumerate() {
+        let mut expected = None;
+        for mode in 0..3 {
+            experimental_math(mode);
+            let before = engine.reranked(Rerank::Accurate).unwrap_or_default();
+            let hits = engine
+                .search_reranked(&query.text, DEPTH as u32, DEPTHS, Rerank::Accurate)
+                .await
+                .unwrap();
+            let after = engine.reranked(Rerank::Accurate).unwrap();
+            assert_eq!(after.maximum_tokens, 256);
+            let mut candidates = experimental_candidates();
+            candidates.sort_by_key(|topic| topic.to_string());
+            assert!(!candidates.is_empty());
+            if let Some(ref initial) = expected {
+                assert_eq!(&candidates, initial, "ANN pool changed");
+            } else {
+                expected = Some(candidates);
+            }
+            let ranked: Vec<String> = hits.into_iter().map(|hit| hit.topic).collect();
+            let mut scores = Scores::default();
+            scores.add(&ranked, query.relevant.len(), |topic| {
+                query.relevant.contains(topic)
+            });
+            output.push(serde_json::json!({"query":query.id,"mode":mode,"profile":named,"project":project,"ranked":ranked,"scores":scores,"new_pairs":after.scored-before.scored,"offered":after.offered-before.offered}));
+        }
+        if (index + 1) % 25 == 0 {
+            println!("FP64 MIRACL paired {}/{}", index + 1, corpus.queries.len());
+        }
+        if (index + 1) % 25 == 0 || index + 1 == corpus.queries.len() {
+            std::fs::write(
+                std::env::var("FP64_OUTPUT").unwrap(),
+                serde_json::to_vec_pretty(&output).unwrap(),
+            )
+            .unwrap();
+        }
+    }
+    experimental_math(0);
+}
