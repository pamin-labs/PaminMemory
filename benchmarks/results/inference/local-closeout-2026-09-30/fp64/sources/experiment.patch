+// Temporary validation hooks; removed after the experiment.
+static EXPERIMENTAL_MATH: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+static EXPERIMENTAL_CANDIDATES: std::sync::Mutex<Vec<TopicId>> = std::sync::Mutex::new(Vec::new());
+pub fn experimental_math(mode: u8) {
+    EXPERIMENTAL_MATH.store(mode, std::sync::atomic::Ordering::Relaxed);
+    EXPERIMENTAL_CANDIDATES.lock().unwrap().clear();
+}
+pub fn experimental_candidates() -> Vec<TopicId> {
+    EXPERIMENTAL_CANDIDATES.lock().unwrap().clone()
+}
+#[cfg(target_os = "macos")]
+#[link(name = "Accelerate", kind = "framework")]
+unsafe extern "C" {
+    fn cblas_dsdot(n: i32, x: *const f32, incx: i32, y: *const f32, incy: i32) -> f64;
+}
+fn experimental_dot64(left: &[f32], right: &[f32]) -> f64 {
+    #[cfg(target_os = "macos")]
+    unsafe {
+        cblas_dsdot(
+            i32::try_from(left.len().min(right.len())).unwrap(),
+            left.as_ptr(),
+            1,
+            right.as_ptr(),
+            1,
+        )
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        left.iter()
+            .zip(right)
+            .map(|(a, b)| f64::from(*a) * f64::from(*b))
+            .sum()
+    }
+}
+fn experimental_ort64(query: &[f32], vectors: &[Vec<f32>]) -> Result<Vec<f64>> {
+    use ort::value::TensorRef;
+    if vectors.is_empty() {
+        return Ok(Vec::new());
+    }
+    static SESSION: std::sync::LazyLock<std::sync::Mutex<ort::session::Session>> =
+        std::sync::LazyLock::new(|| {
+            let path = std::path::PathBuf::from(
+                std::env::var("PAMIN_FP64_MODEL").expect("set the experimental graph path"),
+            );
+            std::sync::Mutex::new(
+                crate::inference::session(vec![crate::inference::cpu()], || Ok(path))
+                    .expect("load the experimental FP64 graph"),
+            )
+        });
+    let values: Vec<f64> = vectors.iter().flatten().copied().map(f64::from).collect();
+    let query_values: Vec<f64> = query.iter().copied().map(f64::from).collect();
+    let failed = |error| IndexError::Engine(format!("experimental FP64 rescore: {error}"));
+    let matrix = TensorRef::from_array_view(([vectors.len(), query.len()], values.as_slice()))
+        .map_err(failed)?;
+    let query =
+        TensorRef::from_array_view(([1, query.len()], query_values.as_slice())).map_err(failed)?;
+    let mut session = SESSION.lock().unwrap();
+    let outputs = session
+        .run(ort::inputs!["vectors"=>matrix,"query"=>query])
+        .map_err(failed)?;
+    Ok(outputs["cosines"]
+        .try_extract_tensor::<f64>()
+        .map_err(failed)?
+        .1
+        .to_vec())
+}
