+#[tokio::test(flavor = "multi_thread")]
+#[ignore = "paired product-path FP64 validation on the complete cached XQuAD-R index"]
+async fn scratch_fp64_product() {
+    use pamin_index::projection::{experimental_candidates, experimental_math};
+    let home = std::env::var("PAMIN_EVAL_HOME").unwrap();
+    assert!(std::env::var_os("HF_HOME").is_none());
+    report_loaded_graphs();
+    let corpus = Corpus::load();
+    let queries = corpus.queries();
+    assert_eq!(queries.len(), 1190);
+    let workspace = Workspace::at(&home);
+    let identity = pinned_embedding_id(&workspace.root().join("models"));
+    let project = xquad_project_name("accuracy", &corpus.fingerprint(), &identity);
+    let engine = Engine::open(
+        &workspace,
+        &project,
+        pamin_index::Profile::Accuracy,
+        VectorIndex::Memory,
+        Access::ReadWrite,
+    )
+    .await
+    .unwrap();
+    assert_eq!(engine.indexed_documents().unwrap(), 13014);
+    assert_eq!(engine.vector_index_completeness().unwrap(), 1.0);
+    let mut result = Vec::new();
+    for (index, query) in queries.iter().enumerate() {
+        let mut expected = None;
+        for mode in 0..3 {
+            experimental_math(mode);
+            let before = engine.reranked(Rerank::Accurate).unwrap_or_default();
+            let hits = engine
+                .search_reranked(query.text(), 60, DEPTHS, Rerank::Accurate)
+                .await
+                .unwrap();
+            let after = engine.reranked(Rerank::Accurate).unwrap();
+            assert_eq!(after.maximum_tokens, 256);
+            let mut candidates = experimental_candidates();
+            candidates.sort_by_key(|topic| topic.to_string());
+            assert!(!candidates.is_empty());
+            if let Some(ref initial) = expected {
+                assert_eq!(&candidates, initial, "ANN pool changed");
+            } else {
+                expected = Some(candidates);
+            }
+            let ranked: Vec<String> = hits.into_iter().map(|hit| hit.topic).collect();
+            let mut scored = BTreeMap::new();
+            score(&mut scored, query, &ranked);
+            result.push(serde_json::json!({"query":index,"mode":mode,"ranked":ranked,"scores":scored,"new_pairs":after.scored-before.scored,"offered":after.offered-before.offered}));
+        }
+        if (index + 1) % 25 == 0 {
+            println!("FP64 XQuAD paired {}/{}", index + 1, queries.len());
+        }
+        if (index + 1) % 25 == 0 || index + 1 == queries.len() {
+            std::fs::write(
+                std::env::var("FP64_OUTPUT").unwrap(),
+                serde_json::to_vec_pretty(&result).unwrap(),
+            )
+            .unwrap();
+        }
+    }
+    experimental_math(0);
+}
