    "cargo_toml": "[package]\nname = \"pamin-sha-trial\"\nversion = \"0.0.0\"\nedition = \"2024\"\n[dependencies]\nsha2 = \"=0.10.9\"\n[features]\nfast = [\"sha2/asm\"]\n",
    "main_rs": "use sha2::{Digest, Sha256};\nuse std::{fs::File, io::Read, time::Instant};\n\nfn main() -> Result<(), Box<dyn std::error::Error>> {\n    assert_eq!(format!(\"{:x}\", Sha256::digest(b\"\")),\n               \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\");\n    assert_eq!(format!(\"{:x}\", Sha256::digest(b\"abc\")),\n               \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\");\n    assert_eq!(format!(\"{:x}\", Sha256::digest(vec![b'a'; 1_000_000])),\n               \"cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0\");\n    let path = std::env::args().nth(1).expect(\"fixture file\");\n    let mut bytes = Vec::new();\n    File::open(path)?.read_to_end(&mut bytes)?;\n    assert_eq!(bytes.len(), 64 * 1024 * 1024);\n    let start = Instant::now();\n    let digest = Sha256::digest(&bytes);\n    println!(\"{} {} {} {:x}\", cfg!(feature = \"fast\"), bytes.len(),\n             start.elapsed().as_secs_f64(), digest);\n    #[cfg(target_arch = \"aarch64\")]\n    assert!(std::arch::is_aarch64_feature_detected!(\"sha2\"), \"this arm must actually support ARM SHA\");\n    Ok(())\n}\n",
