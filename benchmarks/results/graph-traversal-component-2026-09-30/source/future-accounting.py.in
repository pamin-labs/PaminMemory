"""Prospective Linux wait4/log/map capture; not the historical runner source."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import time

RETAINED_PROCESSES=[]
PINS={'ort':'1461ef7cc3d9e49982591721683cc3e3a55580aeca9a5254e7aac47b75ee4bab','zvec':'58381ac7b12afd5eeae3dc10325914a28fc3157061291bb693a9ed757d815b8a'}


def require(ok,message):
    if not ok:raise RuntimeError(message)


def digest(path):
    value=hashlib.sha256()
    with Path(path).open('rb') as stream:
        for block in iter(lambda:stream.read(1024*1024),b''):value.update(block)
    return value.hexdigest()


def maps(pid,expected,cached=None):
    found={};cached={} if cached is None else cached
    try:lines=(Path('/proc')/str(pid)/'maps').read_text().splitlines()
    except FileNotFoundError:return found
    for line in lines:
        fields=line.split(maxsplit=5)
        if len(fields)!=6 or not fields[5].startswith('/'):continue
        name=re.sub(r'\\([0-7]{3})',lambda match:chr(int(match[1],8)),fields[5])
        roles=[role for role,marker in [('ort','libonnxruntime'),('zvec','libzvec_c_api')] if marker in Path(name).name]
        for role in roles:
            require(Path(name)==expected[role],'unexpected actual mapped '+role+' path')
            path=expected[role]
            found[role]=cached.get(role) or {'path':str(path),'sha256':digest(path)}
            require(found[role]['sha256']==PINS[role],'actual mapped '+role+' file differs')
    return found


def capture(command,expected,log,usage,mapped,timeout=900):
    require(set(expected)==set(PINS),'both expected runtime paths required')
    environment=os.environ.copy()
    result=environment.get('GRAPH_OUT')
    require(bool(result),'GRAPH_OUT result path required')
    outputs=[Path(path) for path in [log,usage,mapped,result]]
    require(len({path.resolve() for path in outputs})==len(outputs),'output paths must be distinct after resolving aliases')
    require(all(not os.path.lexists(path) for path in outputs),'outputs must be fresh, including GRAPH_OUT')
    expected={role:Path(path).resolve() for role,path in expected.items()}
    require(all(digest(path)==PINS[role] for role,path in expected.items()),'provided runtime file differs')
    start=time.monotonic();found={};reaped=False;accounting=None;failure=None
    with Path(log).open('x') as stream:
        process=subprocess.Popen(command,stdout=stream,stderr=subprocess.STDOUT,start_new_session=True,env=environment)
        try:
            while True:
                found.update(maps(process.pid,expected,found))
                observed=os.waitid(os.P_PID,process.pid,os.WEXITED|os.WNOHANG|os.WNOWAIT)
                if observed is not None:break
                require(time.monotonic()-start<timeout,'native fixture timeout')
                time.sleep(.1)
            # Keep the leader unreaped until signalling, preventing PGID reuse.
            try:os.killpg(process.pid,signal.SIGKILL)
            except ProcessLookupError:pass
            pid,status,accounting=os.wait4(process.pid,0);reaped=True
            process.returncode=os.waitstatus_to_exitcode(status)
            require(pid==process.pid,'wait4 child identity differs')
            require(process.returncode==0,'native fixture failed; retain log and usage')
            require(set(found)==set(PINS),'both actual runtime mappings must be observed; retain incomplete evidence')
            require(all(digest(path)==PINS[role] for role,path in expected.items()),'runtime inputs changed during native fixture')
        except BaseException as error:
            failure=error
            raise
        finally:
            if not reaped:
                # A still-owned unreaped child reserves its process group ID.
                os.waitid(os.P_PID,process.pid,os.WEXITED|os.WNOHANG|os.WNOWAIT)
                try:os.killpg(process.pid,signal.SIGKILL)
                except ProcessLookupError:pass
                deadline=time.monotonic()+10
                while os.waitid(os.P_PID,process.pid,os.WEXITED|os.WNOHANG|os.WNOWAIT) is None:
                    if time.monotonic()>=deadline:
                        RETAINED_PROCESSES.append(process)
                        raise RuntimeError('owned child did not exit after bounded kill; accounting unavailable; retain log')
                    time.sleep(.1)
                _,status,accounting=os.wait4(process.pid,0);reaped=True
                process.returncode=os.waitstatus_to_exitcode(status)
            report={'wall_seconds':time.monotonic()-start,'user_seconds':accounting.ru_utime,
                    'system_seconds':accounting.ru_stime,'maximum_process_rss_kib':accounting.ru_maxrss,
                    'exit_status':process.returncode,
                    'scope':'Linux wait4 of native test process; setup included, independent services excluded'}
            packet={'scope':'prospective observed mappings and file digests; no mapped inode attestation; not historical trace evidence','libraries':found,'accepted':failure is None}
            if failure is not None:
                report.update(capture_accepted=False,capture_error=str(failure))
                packet['capture_error']=str(failure)
            with Path(usage).open('x') as target:target.write(json.dumps(report,indent=2)+'\n')
            with Path(mapped).open('x') as target:target.write(json.dumps(packet,indent=2)+'\n')
    return report


def main():
    parser=argparse.ArgumentParser()
    for name in ['ort','zvec','log','usage','mapped']:parser.add_argument('--'+name,required=True)
    parser.add_argument('command',nargs=argparse.REMAINDER)
    args=parser.parse_args();command=args.command
    if command[:1]==['--']:command=command[1:]
    require(bool(command),'native fixture command required')
    capture(command,{'ort':args.ort,'zvec':args.zvec},args.log,args.usage,args.mapped)


if __name__=='__main__':main()
