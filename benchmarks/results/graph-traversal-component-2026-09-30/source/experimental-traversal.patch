+// The measurement generator flips this in untracked source copies. This
+// prototype adds no environment-controlled mode to product builds.
+const USE_SCORED_GRAPH_RECALL: bool = false;
+
+/// Experimental score-aware recall. Only the strongest explored arrival for
+/// each topic is returned. A frontier cap still makes this approximate; the
+/// bound on discarded work is reported rather than claimed to be settled.
+async fn scored_graph_recall(
+    connection: &mut PgConnection,
+    project: ProjectId,
+    seeds: &[TopicId],
+    depth: u8,
+    keep: usize,
+    worth: impl Fn(f32, u8, TopicId) -> f32,
+) -> Result<Vec<Neighbor>> {
+    if keep == 0 || seeds.is_empty() {
+        return Ok(Vec::new());
+    }
+    let depth = depth.min(graph::MAX_DEPTH);
+    let mut reached = std::collections::HashMap::new();
+    let mut frontier: Vec<_> = seeds
+        .iter()
+        .map(|seed| graph::RecallPosition {
+            topic: *seed,
+            origin: *seed,
+            via: *seed,
+        })
+        .collect();
+    for hop in 1..=depth {
+        let mut walk = graph::recall_hop(connection, project, &frontier, hop, Some(keep)).await?;
+        let floor = {
+            let mut preview = reached.clone();
+            retain_graph_arrivals(&mut preview, &walk.arrivals, &worth);
+            graph_floor(&preview, keep, &worth)
+        };
+        // The final edge supplies confidence, not a path product. Even an
+        // unread weak edge can lead to a certain edge at the next hop.
+        let cuts_settled = recall_cuts_settled(&walk.unread, hop, depth, floor, &worth);
+        if !cuts_settled {
+            drop(walk);
+            walk = graph::recall_hop(connection, project, &frontier, hop, None).await?;
+        }
+        retain_graph_arrivals(&mut reached, &walk.arrivals, &worth);
+        if hop == depth {
+            break;
+        }
+        let floor = graph_floor(&reached, keep, &worth);
+        frontier = recall_frontier(&walk.arrivals, hop + 1, floor, &worth);
+        // Retaining via in the key preserves the different backtracking
+        // exclusions of two routes to the same (topic, origin).
+        const MAX_RECALL_FRONTIER: usize = 2_000;
+        if frontier.len() > MAX_RECALL_FRONTIER {
+            let discarded_bound = worth(1.0, hop + 1, frontier[MAX_RECALL_FRONTIER].origin);
+            tracing::debug!(
+                hop,
+                discarded = frontier.len() - MAX_RECALL_FRONTIER,
+                discarded_bound,
+                "scored graph recall capped unresolved frontier work"
+            );
+            frontier.truncate(MAX_RECALL_FRONTIER);
+        }
+        if frontier.is_empty() {
+            break;
+        }
+    }
+    Ok(graph::strongest(
+        reached.into_values().collect(),
+        keep,
+        worth,
+    ))
+}
+
+fn recall_cuts_settled(
+    unread: &[graph::Unread],
+    hop: u8,
+    depth: u8,
+    floor: Option<f32>,
+    worth: impl Fn(f32, u8, TopicId) -> f32,
+) -> bool {
+    unread.iter().all(|cut| {
+        cut.origins.iter().all(|origin| {
+            let bound = worth(cut.confidence, hop, *origin).max(if hop < depth {
+                worth(1.0, hop + 1, *origin)
+            } else {
+                0.0
+            });
+            floor.is_some_and(|floor| floor > bound)
+        })
+    })
+}
+
+fn retain_graph_arrivals(
+    reached: &mut std::collections::HashMap<TopicId, Neighbor>,
+    arrivals: &[Neighbor],
+    worth: impl Fn(f32, u8, TopicId) -> f32,
+) {
+    for arrival in arrivals {
+        reached
+            .entry(arrival.topic)
+            .and_modify(|held| {
+                let order = worth(arrival.confidence, arrival.hops, arrival.origin)
+                    .total_cmp(&worth(held.confidence, held.hops, held.origin))
+                    .then_with(|| held.hops.cmp(&arrival.hops))
+                    .then_with(|| held.origin.0.cmp(&arrival.origin.0))
+                    .then_with(|| held.via.0.cmp(&arrival.via.0))
+                    .then_with(|| held.kind.cmp(&arrival.kind))
+                    .then_with(|| held.outbound.cmp(&arrival.outbound));
+                if order.is_gt() {
+                    *held = arrival.clone();
+                }
+            })
+            .or_insert_with(|| arrival.clone());
+    }
+}
+
+fn graph_floor(
+    reached: &std::collections::HashMap<TopicId, Neighbor>,
+    keep: usize,
+    worth: impl Fn(f32, u8, TopicId) -> f32,
+) -> Option<f32> {
+    let ranked = graph::strongest(reached.values().cloned().collect(), keep, &worth);
+    ranked
+        .get(keep.checked_sub(1)?)
+        .map(|last| worth(last.confidence, last.hops, last.origin))
+}
+
+fn recall_frontier(
+    arrivals: &[Neighbor],
+    next_hop: u8,
+    floor: Option<f32>,
+    worth: impl Fn(f32, u8, TopicId) -> f32,
+) -> Vec<graph::RecallPosition> {
+    let mut once = std::collections::HashSet::new();
+    let mut frontier: Vec<_> = arrivals
+        .iter()
+        // Strict comparison keeps all ties: a future topic can win the
+        // identifier tie-break even when its bound equals the current floor.
+        .filter(|arrival| !floor.is_some_and(|floor| floor > worth(1.0, next_hop, arrival.origin)))
+        .filter(|arrival| once.insert((arrival.topic, arrival.origin, arrival.via)))
+        .map(|arrival| graph::RecallPosition {
+            topic: arrival.topic,
+            origin: arrival.origin,
+            via: arrival.via,
+        })
+        .collect();
+    frontier.sort_by(|left, right| {
+        worth(1.0, next_hop, right.origin)
+            .total_cmp(&worth(1.0, next_hop, left.origin))
+            .then_with(|| left.topic.0.cmp(&right.topic.0))
+            .then_with(|| left.origin.0.cmp(&right.origin.0))
+            .then_with(|| left.via.0.cmp(&right.via.0))
+    });
+    frontier
+}
