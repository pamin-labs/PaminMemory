+/// All explored arrivals from a recall hop, and bounds on unread crossings.
+/// Unlike [`Walk`], arrivals are not reduced by the neighbor API's policy.
+pub struct RecallHop {
+    pub arrivals: Vec<Neighbor>,
+    pub unread: Vec<Unread>,
+}
+
+/// Reads a single hop without selecting an arrival or suppressing revisits.
+/// Recall ranking and future-hop pruning belong to the caller. The neighbor
+/// API uses the same crossings with its own breadth-first visited policy.
+pub async fn recall_hop(
+    connection: &mut sqlx::PgConnection,
+    project: ProjectId,
+    frontier: &[RecallPosition],
+    hop: u8,
+    per_topic: Option<usize>,
+) -> Result<RecallHop> {
+    let mut positions: Vec<_> = frontier.iter().map(|step| step.topic.0).collect();
+    positions.sort_unstable();
+    positions.dedup();
+    let (edges, cuts) = match per_topic {
+        Some(limit) => strongest_edges(connection, project, &positions, None, limit.max(1)).await?,
+        None => (
+            every_edge(connection, project, &positions, None, None).await?,
+            Vec::new(),
+        ),
+    };
+    let unread = cuts
+        .into_iter()
+        .map(|cut| {
+            let mut origins: Vec<_> = frontier
+                .iter()
+                .filter(|step| step.topic == cut.standing)
+                .map(|step| step.origin)
+                .collect();
+            origins.sort_unstable_by_key(|origin| origin.0);
+            origins.dedup();
+            Unread {
+                hops: hop,
+                via: cut.standing,
+                confidence: cut.confidence,
+                after: cut.after,
+                origins,
+            }
+        })
+        .collect();
+    let mut arrivals = Vec::new();
+    visit_arrivals(hop, frontier, &edges, |arrival| arrivals.push(arrival));
+    Ok(RecallHop { arrivals, unread })
+}
